    def PhysicsScene "PhysicsScene"
    {
        vector3f physics:gravityDirection = (0, 0, -1)
        float physics:gravityMagnitude = 9.81
    }

    def Scope "Lighting"
    {
        def DomeLight "RTX_DomeLight"
        {
            color3f inputs:color = (0.92, 0.95, 1)
            float inputs:intensity = 1500
        }

        def DistantLight "HighBay_SunLight"
        {
            color3f inputs:color = (1, 0.98, 0.94)
            float inputs:intensity = 3500
            float3 xformOp:rotateXYZ = (-45, 30, 0)
            uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
        }
    }

