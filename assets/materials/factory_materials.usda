#usda 1.0
(
    defaultPrim = "Materials"
    metersPerUnit = 1
    upAxis = "Z"
)

def Scope "Materials"
{
    def Material "FloorEpoxyGray" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        token outputs:surface.connect = </Materials/FloorEpoxyGray/PbrShader.outputs:surface>
        float physics:dynamicFriction = 0.35
        float physics:restitution = 0.15
        float physics:staticFriction = 0.4

        def Shader "PbrShader"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.35, 0.38, 0.42)
            float inputs:metallic = 0.3
            float inputs:roughness = 0.45
            token outputs:surface
        }
    }

    def Material "FloorWalkwayGreen" (
