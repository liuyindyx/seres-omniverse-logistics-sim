#usda 1.0
(
    defaultPrim = "Materials"
    metersPerUnit = 1
    upAxis = "Z"
)

def Scope "Materials"
{
    def Material "FloorEpoxyGray" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        token outputs:surface.connect = </Materials/FloorEpoxyGray/PbrShader.outputs:surface>
        float physics:dynamicFriction = 0.4
        float physics:restitution = 0.15
        float physics:staticFriction = 0.45

        def Shader "PbrShader"
        {
            uniform token info:id = "UsdPreviewSurface"
            float inputs:clearcoat = 0.4
            float inputs:clearcoatRoughness = 0.08
            color3f inputs:diffuseColor = (0.22, 0.25, 0.29)
            float inputs:metallic = 0.15
            float inputs:opacity = 1
            float inputs:roughness = 0.28
            token outputs:surface
        }
    }

